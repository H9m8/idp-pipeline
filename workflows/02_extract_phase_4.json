        "jsCode": "const binaryData = $input.item.binary;\n\nif (!binaryData || Object.keys(binaryData).length === 0) {\n  throw new Error('No binary file received.');\n}\n\nconst fileKey = Object.keys(binaryData)[0];  // grabs \"file0\" automatically\nconst file = binaryData[fileKey];\n\nreturn {\n  json: {\n    file_name: file?.fileName ?? 'unknown.pdf',\n    mime_type: file?.mimeType ?? 'application/octet-stream',\n    file_size: Number(file?.fileSize) || 0,\n  },\n  binary: binaryData\n};"
