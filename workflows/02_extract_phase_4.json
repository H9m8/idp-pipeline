    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $('Information Extractor').item.json.output;\nconst TOL = 0.02;\nconst toNum = (v) => (v === null || v === undefined || isNaN(Number(v)) ? null : Number(v));\nconst anomalies = [];\n\n// required fields\nif (!data.vendor_name) anomalies.push({ kind: 'missing_field', detail: 'vendor_name missing', severity: 'warning' });\nif (toNum(data.total) === null) anomalies.push({ kind: 'missing_field', detail: 'total missing', severity: 'error' });\nconst items = data.line_items || [];\nif (items.length === 0) anomalies.push({ kind: 'missing_field', detail: 'no line items', severity: 'warning' });\n\n// line items sum vs subtotal\nconst subtotal = toNum(data.subtotal);\nif (subtotal !== null && items.length) {\n  const sum = items.reduce((s, it) => s + (toNum(it.amount) || 0), 0);\n  if (Math.abs(sum - subtotal) > TOL)\n    anomalies.push({ kind: 'line_items_sum_mismatch', detail: `items sum ${sum.toFixed(2)} != subtotal ${subtotal.toFixed(2)}`, severity: 'error' });\n}\n\n// subtotal + tax vs total\nconst tax = toNum(data.tax) || 0;\nconst total = toNum(data.total);\nif (subtotal !== null && total !== null) {\n  const expected = subtotal + tax;\n  if (Math.abs(expected - total) > TOL)\n    anomalies.push({ kind: 'total_mismatch', detail: `expected ${expected.toFixed(2)} != total ${total.toFixed(2)}`, severity: 'error' });\n}\n\n// date\nif (data.invoice_date) {\n  const d = new Date(data.invoice_date);\n  if (isNaN(d.getTime())) anomalies.push({ kind: 'invalid_date', detail: `bad date ${data.invoice_date}`, severity: 'warning' });\n  else if (d > new Date()) anomalies.push({ kind: 'future_date', detail: `future date ${data.invoice_date}`, severity: 'warning' });\n}\n\nconst status = anomalies.length ? 'needs_review' : 'validated';\nreturn { json: { anomalies, status } };"
      },
